PY ?= python3
CC ?= gcc
CFLAGS ?= -std=c99 -Wall -Wextra -O2

.PHONY: all codes check test build clean

all: codes build

codes:
	$(PY) tools/gen_cmd_table.py protocol/commands.csv src/lb2_cmd_table.h

# same check the CM runs at intake
check:
	/opt/fbtools/bin/fbcheck protocol/commands.csv

test:
	$(PY) -m unittest discover -s tests

build: codes
	@mkdir -p build
	$(CC) $(CFLAGS) -c src/lb2_phy.c -o build/lb2_phy.o
	$(CC) $(CFLAGS) -c src/crc16.c -o build/crc16.o

clean:
	rm -rf build
