#!/usr/bin/env python3
"""submit-plan - score a route plan and put it in the results cache.

usage: submit-plan PLAN.csv [--note TEXT] [--data DIR]
       submit-plan --list [--ticket PLN-xxxx]

Valid plans are copied to /workspace/results-cache/<host>/ together with a
small .json record (ticket, host, user, time, km, note). The promotion job
reads the cache at window close and re-scores each host's best plan.
"""

import argparse
import datetime
import getpass
import glob
import json
import os
import socket
import sys
import tempfile
import uuid

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "lib"))
import routecheck as rc  # noqa: E402

CACHE = os.environ.get("PLAN_CACHE_DIR", "/workspace/results-cache")


def ticket_of(data_dir):
    d = os.path.abspath(data_dir)
    name = os.path.basename(d)
    return (os.path.basename(os.path.dirname(d)) if name == "data" else name) or "unknown"


def write_atomic(path, data, mode=0o664):
    """Write to a temp file in the same folder, then rename: readers never see half a file."""
    folder = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=folder)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        try:
            os.chmod(tmp, mode)
        except OSError:
            pass
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def find_data(plan, data):
    if data:
        return data
    d = os.path.dirname(os.path.abspath(plan))
    for _ in range(4):
        if os.path.isfile(os.path.join(d, "data", "stops.csv")):
            return os.path.join(d, "data")
        d = os.path.dirname(d)
    return "/workspace/PLN-5521/data"


def list_entries(ticket):
    rows = []
    for meta in glob.glob(os.path.join(CACHE, "*", "*.json")):
        try:
            with open(meta) as f:
                m = json.load(f)
        except (OSError, ValueError):
            continue
        if ticket and m.get("ticket") != ticket:
            continue
        rows.append(m)
    if not rows:
        print("no entries in %s" % CACHE)
        return 0
    rows.sort(key=lambda m: (m.get("ticket", ""), m.get("total_km", 1e9), m.get("submitted", "")))
    best = {}
    for m in rows:
        key = (m.get("ticket"), m.get("host"))
        best.setdefault(key, m)
    print("%-9s %-10s %-6s %-24s %9s  %s" % ("ticket", "host", "user", "submitted (UTC)", "km", "note"))
    for m in rows:
        star = "*" if best[(m.get("ticket"), m.get("host"))] is m else " "
        print("%-9s %-10s %-6s %-24s %8.1f%s  %s" % (m.get("ticket", "?"), m.get("host", "?"), m.get("user", "?"),
                                                    m.get("submitted", "?"), m.get("total_km", 0.0), star,
                                                    m.get("note", "")))
    print("* = best on that host (what the promotion job will re-score)")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="submit-plan")
    ap.add_argument("plan", nargs="?")
    ap.add_argument("--note", default="")
    ap.add_argument("--data")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--ticket")
    a = ap.parse_args(argv)
    if a.list:
        return list_entries(a.ticket)
    if not a.plan:
        ap.error("PLAN.csv required (or --list)")

    data, note = rc.resolve_data(find_data(a.plan, a.data))
    if note:
        print(note, file=sys.stderr)
    inst = rc.Instance(data)
    try:
        routes = rc.read_plan(a.plan)
    except (ValueError, OSError) as e:
        print("submit-plan: %s" % e, file=sys.stderr)
        return 2
    total, per_van, problems = rc.check_plan(inst, routes)
    if problems:
        for p in problems:
            print("INVALID  " + p)
        print("not submitted")
        return 1

    host = socket.gethostname().split(".")[0]
    user = getpass.getuser()
    now = datetime.datetime.now(datetime.timezone.utc)
    ticket = ticket_of(data)
    dest = os.path.join(CACHE, host)
    if not os.path.isdir(dest):
        os.makedirs(dest, exist_ok=True)
        try:
            os.chmod(dest, 0o2775)  # shared with the other accounts on this host
        except OSError:
            pass
    entry = uuid.uuid4().hex[:8]  # unique per submission, so equal scores never collide
    stem = "%s_%s_%.1f_%s" % (ticket, now.strftime("%Y%m%dT%H%M%S"), total, entry)
    with open(a.plan, "rb") as f:
        plan_bytes = f.read()
    meta = {"id": entry, "ticket": ticket, "host": host, "user": user,
            "submitted": now.strftime("%Y-%m-%d %H:%M:%S.%f")[:-3], "total_km": total, "vans": len(per_van),
            "plan": stem + ".csv", "note": a.note}
    write_atomic(os.path.join(dest, stem + ".csv"), plan_bytes)
    write_atomic(os.path.join(dest, stem + ".json"), (json.dumps(meta, indent=1) + "\n").encode())
    print("submitted %s: %.1f km, %d vans -> %s" % (ticket, total, len(per_van), os.path.join(dest, stem + ".csv")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
