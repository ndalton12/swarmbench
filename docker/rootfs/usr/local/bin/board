#!/usr/local/bin/python3
"""board - team message board.

Posts live under /board/<channel>/, one file per post. The author of a post is
the owner of its file.
"""

import argparse
import os
import pwd
import re
import sys
import time
from datetime import datetime
from pathlib import Path

BOARD = Path(os.environ.get("BOARD_DIR", "/board"))
SEEN = Path.home() / ".board_seen"
CHANNEL_RE = re.compile(r"[a-z0-9][a-z0-9_-]{0,31}")
MAX_POST = 64 * 1024


def owner(path: Path) -> str:
    uid = path.stat().st_uid
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


def post_time(path: Path) -> float:
    match = re.match(r"(\d{10,})-", path.name)
    if match:
        return int(match.group(1)) / 1000
    return path.stat().st_mtime


def channels() -> list[Path]:
    if not BOARD.is_dir():
        return []
    return sorted(p for p in BOARD.iterdir() if p.is_dir() and not p.name.startswith("."))


def posts(channel: Path) -> list[Path]:
    return [p for p in channel.iterdir() if p.is_file() and not p.name.startswith(".")]


def load_seen() -> set[str]:
    try:
        return set(SEEN.read_text().split())
    except OSError:
        return set()


def save_seen(seen: set[str]) -> None:
    try:
        tmp = SEEN.with_name(SEEN.name + ".tmp")
        tmp.write_text("".join(f"{s}\n" for s in sorted(seen)))
        os.replace(tmp, SEEN)
    except OSError:
        pass


def check_channel(name: str) -> str:
    name = name.lstrip("#")
    if not CHANNEL_RE.fullmatch(name):
        sys.exit(f"board: invalid channel name '{name}' (use lowercase letters, digits, - and _)")
    return name


def cmd_post(args: argparse.Namespace) -> None:
    channel = check_channel(args.channel)
    if args.message is not None:
        text = args.message
    elif args.file in (None, "-"):
        if sys.stdin.isatty():
            print("Type the post, then Ctrl-D:", file=sys.stderr)
        text = sys.stdin.read()
    else:
        text = Path(args.file).read_text()
    text = text.strip()
    if not text:
        sys.exit("board: empty post, nothing written")
    if len(text.encode()) > MAX_POST:
        sys.exit(f"board: post too long (limit {MAX_POST // 1024} KB)")

    folder = BOARD / channel
    if not folder.is_dir():
        folder.mkdir()
        os.chmod(folder, 0o3775)
    user = pwd.getpwuid(os.getuid()).pw_name
    while True:
        path = folder / f"{int(time.time() * 1000)}-{user}.md"
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
            break
        except FileExistsError:
            time.sleep(0.002)
    with os.fdopen(fd, "w") as f:
        f.write(text + "\n")
    seen = load_seen()
    seen.add(f"{channel}/{path.name}")
    save_seen(seen)
    print(f"posted to #{channel}")


def cmd_read(args: argparse.Namespace) -> None:
    if args.channel:
        name = check_channel(args.channel)
        folder = BOARD / name
        if not folder.is_dir():
            sys.exit(f"board: no channel #{name} (see 'board channels')")
        selected = [folder]
    else:
        selected = channels()

    seen = load_seen()
    items = []
    for folder in selected:
        for path in posts(folder):
            key = f"{folder.name}/{path.name}"
            if args.new and key in seen:
                continue
            try:
                items.append((post_time(path), folder.name, path, key))
            except OSError:
                continue
    items.sort()
    if args.limit and len(items) > args.limit:
        skipped = len(items) - args.limit
        items = items[-args.limit :]
        print(f"({skipped} older posts not shown; use --limit to see more)\n")
    if not items:
        print("no new posts" if args.new else "no posts")
        return
    for t, channel, path, key in items:
        try:
            text = path.read_text(errors="replace")[:MAX_POST].rstrip()
            author = owner(path)
        except OSError:
            continue
        stamp = datetime.fromtimestamp(t).strftime("%Y-%m-%d %H:%M")
        print(f"{stamp}  {author}  #{channel}\n{text}\n")
        seen.add(key)
    save_seen(seen)


def cmd_channels(args: argparse.Namespace) -> None:
    seen = load_seen()
    found = channels()
    if not found:
        print("no channels yet")
        return
    for folder in found:
        names = [p.name for p in posts(folder)]
        unread = sum(1 for n in names if f"{folder.name}/{n}" not in seen)
        print(f"#{folder.name:<20} {len(names):>4} posts  {unread:>4} unread")


def main() -> None:
    parser = argparse.ArgumentParser(prog="board", description="Team message board.")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("post", help="post a message to a channel")
    p.add_argument("channel")
    p.add_argument("file", nargs="?", help="file to post, or - for stdin (default)")
    p.add_argument("-m", "--message", help="post this text instead of reading a file")
    p.set_defaults(func=cmd_post)

    r = sub.add_parser("read", help="read posts (all channels, or one)")
    r.add_argument("channel", nargs="?")
    r.add_argument("--new", action="store_true", help="only posts you haven't seen")
    r.add_argument("--limit", type=int, default=50, help="show at most N posts (default 50)")
    r.set_defaults(func=cmd_read)

    c = sub.add_parser("channels", help="list channels")
    c.set_defaults(func=cmd_channels)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
